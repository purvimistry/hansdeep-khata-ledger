@model HansdeepKhataLedger.Web.Models.PaymentEntry.PaymentEntryViewModel

@{
    ViewData["Title"] = "Add Payment";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tom-select/css/tom-select.css" />
}

<div class="customer-form-page">
    <div class="page-header">
        <a asp-action="Index" class="back-link">
            <svg viewBox="0 0 24 24">
                <path d="M15 18l-6-6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round" />
            </svg>
            Back
        </a>

        <h1>Add Payment</h1>
        <p>Record a payment received from a customer.</p>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="customer-card">

            <div class="card-title">
                <div class="title-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 5v14M5 12h14"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round" />
                    </svg>
                </div>

                <div>
                    <h3>Payment Information</h3>
                    <span>Customer and transaction details</span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors">
            </div>

            <div class="form-grid">

                <div class="form-group">
                    <label asp-for="CustomerId">
                        Customer <span>*</span>
                    </label>

                    <select asp-for="CustomerId"
                            asp-items="Model.Customers"
                            id="CustomerId"
                            class="form-select">
                        <option value=""></option>
                    </select>

                    <span asp-validation-for="CustomerId"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Amount">
                        Payment Amount (₹) <span>*</span>
                    </label>

                    <input asp-for="Amount"
                           type="number"
                           min="0.01"
                           step="0.01"
                           class="form-control"
                           placeholder="Enter payment amount" />

                    <span asp-validation-for="Amount"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EntryDate">
                        Payment Date <span>*</span>
                    </label>

                    <input asp-for="EntryDate"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />

                    <span asp-validation-for="EntryDate"
                          class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Description">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control notes-box"
                              placeholder="Add payment details (optional)"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

            </div>

            <div class="form-footer">
                <a asp-controller="PaymentEntries"
                   asp-action="Index"
                   class="secondary-btn">
                    Cancel
                </a>

                <button type="submit" class="primary-btn">
                    Save Payment
                </button>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            new TomSelect("#CustomerId", {
                create: false,
                allowEmptyOption: true,
                placeholder: "Search customer by name...",
                maxOptions: 1000
            });

        });
    </script>
}
