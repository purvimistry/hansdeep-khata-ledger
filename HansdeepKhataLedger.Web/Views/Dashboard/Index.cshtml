@using System.Security.Claims
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var username = User.Identity?.Name;
    username = string.IsNullOrWhiteSpace(username) ? "Admin" : username;  
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}
<div class="dashboard-wrapper">
    <!-- DASHBOARD HEADER -->
    <div class="dashboard-header">
        <div>
            <h2 class="dashboard-title">Welcome back, @username!</h2>
            <p class="dashboard-subtitle">
                Here's what's happening with your business today.
            </p>
        </div>
        <div class="dashboard-actions">
            <a href="~/Customer/Create" class="primary-action-btn">
                + Add Customer
            </a>
            <a href="#" class="secondary-action-btn">
                + Credit Entry
            </a>
        </div>
    </div>
    <!-- KPI CARDS -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon customers-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </div>

            <div class="stat-details">
                <span class="stat-label">Total Customers</span>
                <h3 class="stat-value">1,248</h3>
                <span class="stat-meta positive-text">
                    +12 customers this month
                </span>
            </div>
        </div>

        <div class="stat-card highlight-card">
            <div class="stat-icon pending-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 7h18v12H3z" />
                    <path d="M3 10h18" />
                    <circle cx="17" cy="16" r="1" />
                </svg>
            </div>

            <div class="stat-details">
                <span class="stat-label">Total Pending Amount</span>
                <h3 class="stat-value">₹ 2,48,530</h3>
                <span class="stat-meta warning-text">
                    Outstanding customer balance
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon credit-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M6 2h12v20l-2-1-2 1-2-1-2 1-2-1-2 1V2z" />
                    <line x1="8" y1="7" x2="16" y2="7" />
                    <line x1="8" y1="11" x2="16" y2="11" />
                    <line x1="8" y1="15" x2="13" y2="15" />
                </svg>
            </div>

            <div class="stat-details">
                <span class="stat-label">Today's Credit</span>
                <h3 class="stat-value">₹ 4,520</h3>
                <span class="stat-meta neutral-text">
                    18 credit entries added today
                </span>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon collection-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="12" rx="2" />
                    <circle cx="12" cy="12" r="3" />
                    <line x1="6" y1="12" x2="6.01" y2="12" />
                    <line x1="18" y1="12" x2="18.01" y2="12" />
                </svg>
            </div>

            <div class="stat-details">
                <span class="stat-label">Today's Collection</span>
                <h3 class="stat-value">₹ 3,700</h3>
                <span class="stat-meta positive-text">
                    Payments received today
                </span>
            </div>
        </div>

    </div>

    <div class="dashboard-content-grid">
        <!-- RECENT LEDGER ENTRIES -->
        <div class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h3>Recent Ledger Entries</h3>
                    <p>Latest customer borrow records</p>
                </div>
                <a href="#" class="view-all-link">View All</a>
            </div>
            <div class="table-responsive">
                @await Html.PartialAsync("_RecentLedgerEntries")
            </div>
           
        </div>
        <!-- RECENT PAYMENTS -->
        <div class="dashboard-panel">
            <div class="panel-header">
                <div>
                    <h3>Recent Payments</h3>
                    <p>Latest received collections</p>
                </div>
                <a href="#" class="view-all-link">View All</a>
            </div>
            <div class="table-responsive">
                @await Html.PartialAsync("_RecentPayments")
            </div>
            
        </div>

    </div>
</div>