@model HansdeepKhataLedger.Web.Models.Customer.CustomerIndexViewModel

<div class="table-card">
    <table class="customer-table">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Contact</th>
                <th>Location</th>
                <th>Pending</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if(Model.Customers.Any())
            {
                foreach(var customer in Model.Customers)
                {
                    <tr>
                        <td>
                            <div class="customer-name">
                                @customer.FullName
                            </div>
                        </td>
                        <td>@customer.MobileNumber</td>
                        <td>
                            <div class="customer-location">
                                @if (!string.IsNullOrWhiteSpace(customer.AreaName))
                                {
                                    <strong>@customer.AreaName</strong>
                                }
                                <small>@customer.VillageName</small>
                            </div>
                         </td>
                        <td>₹ @customer.PendingBalance.ToString("N2")</td>
                        <td>
                            @if(customer.IsActive)
                            {
                                <span class="badge-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge-danger">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td>
                            <div class="action-links">
                                <a asp-action="Edit"
                                   asp-route-id="@customer.Id">
                                    Edit
                                </a>
                                <a  asp-controller="Ledger"
                                    asp-action="Index"
                                   asp-route-customerId="@customer.Id">
                                    Open Ledger
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">
                        <div class="empty-state">
                            No customers found.
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>