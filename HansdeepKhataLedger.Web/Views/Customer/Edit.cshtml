@model HansdeepKhataLedger.Web.Models.Customer.CustomerFormViewModel

@{
    ViewData["Title"] = "Edit Customer";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer-form.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/tom-select/css/tom-select.css" />
}

<div class="customer-form-page">

    <div class="page-header">
        <a asp-action="Index" class="back-link">
            <svg viewBox="0 0 24 24">
                <path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Back to Customers
        </a>
        <h1>Edit Customer</h1>
        <p>Update customer information.</p>
    </div>

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        @await Html.PartialAsync("_CustomerForm", Model)

    </form>
</div>
<!--MODAL-->
@await Html.PartialAsync("_EntityModal", Model)

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/js/customer-form.js" asp-append-version="true"></script>

}