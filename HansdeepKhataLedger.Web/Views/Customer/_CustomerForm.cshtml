@model HansdeepKhataLedger.Web.Models.Customer.CustomerFormViewModel

<div asp-validation-summary="ModelOnly"
     class="validation-summary-errors">
</div>
<div class="customer-card">
    <div class="card-title">
        <div class="title-icon">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M4 20a8 8 0 0 1 16 0" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
        </div>
        <div>
            <h3>Customer Information</h3>
            <span> Basic personal and location details</span>
        </div>
    </div>
    <div class="form-grid">

        <div class="form-group">
            <label asp-for="FullName"> Full Name <span>*</span> </label>
            <input asp-for="FullName" class="form-control" placeholder="Enter customer name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MobileNumber"> Mobile Number <span>*</span></label>
            <input asp-for="MobileNumber" class="form-control" placeholder="9876543210" />
            <span asp-validation-for="MobileNumber" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="AlternateMobileNumber"> Alternate Number</label>
            <input asp-for="AlternateMobileNumber" class="form-control" placeholder="Optional" />
        </div>

        <div class="form-group">
            <label asp-for="AdvanceBalance"> Advance Balance</label>
            <input asp-for="AdvanceBalance" type="number" class="form-control" placeholder="0.00" min="0"
                   step="0.01" onkeydown="return ['e','E','+','-'].indexOf(event.key) === -1;" />
        </div>

        <div class="form-group">
            <label asp-for="VillageId"> Village <span>*</span></label>
            <div class="select-with-button">
                <select asp-for="VillageId" asp-items="ViewBag.Villages" id="VillageId" class="form-select">
                    <option value=""></option>
                </select>
                <button type="button"
                        id="btnAddVillage"
                        class="add-btn">
                    + Add
                </button>
            </div>
            <span asp-validation-for="VillageId" class="text-danger"></span>

            <div id="villageServerError" class="field-server-error"></div>
        </div>

        <div class="form-group">
            <label asp-for="AreaId"> Area</label>
            <div class="select-with-button">
                <select asp-for="AreaId" asp-items="ViewBag.Areas" id="AreaId" class="form-select" disabled>
                    <option value=""></option>
                </select>
                <button type="button"
                        id="btnAddArea"
                        class="add-btn" disabled>
                    + Add
                </button>
            </div>
            <span id="areaHint" class="field-hint" style="display:none;">
                Please select a village before adding an area.
            </span>
        </div>

        <div class="form-group full-width">
            <label asp-for="Notes"> Notes</label>
            <textarea asp-for="Notes" class="form-control notes-box" placeholder="Any remarks about the customer..."></textarea>
        </div>
    </div>

    <div class="form-footer">
        <a asp-action="Index" class="secondary-btn"> Cancel </a>
        <button type="submit" class="primary-btn">Save Customer</button>
    </div>
</div>