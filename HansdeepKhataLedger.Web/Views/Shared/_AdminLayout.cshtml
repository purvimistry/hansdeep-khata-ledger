<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hansdeep Khata Ledger</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HansdeepKhataLedger.Web.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-container">

        @await Html.PartialAsync("_Sidebar")

        <div class="main-content">

            <!-- HEADER NAVIGATION SECTION -->
            <header>
                @await Html.PartialAsync("_TopNavbar")
            </header>

            <!-- CENTRAL WORKSPACE LAYER -->
            <div class="content-area">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>

            <!-- FOOTER CONTAINER -->
            <footer class="border-top footer text-muted mt-auto py-3 bg-white px-4">
                <div class="container-fluid d-flex justify-content-between align-items-center">
                    <span>&copy; 2026 - HansdeepKhataLedger.Web</span>
                </div>
            </footer>

        </div>
    </div>
   
    @if (TempData["Success"] != null)
    {
        <div class="toast toast-success" id="appToast">
            <div class="toast-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M20 6L9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </div>

            <div class="toast-content">
                <div class="toast-title">Success</div>
                <div class="toast-message">
                    @TempData["Success"]
                </div>
            </div>

            <button type="button" class="toast-close" onclick="closeToast()">
                ×
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" id="appToast">
            <div class="toast-icon">
                <svg viewBox="0 0 24 24">
                    <path d="M12 8v5m0 3h.01M12 2a10 10 0 100 20 10 10 0 000-20z" fill="none" stroke="currentColor" stroke-width="2" />
                </svg>
            </div>

            <div class="toast-content">
                <div class="toast-title">Error</div>
                <div class="toast-message">
                    @TempData["Error"]
                </div>
            </div>

            <button type="button" class="toast-close" onclick="closeToast()">
                ×
            </button>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
