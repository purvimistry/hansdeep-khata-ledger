@model HansdeepKhataLedger.Web.Models.CreditEntry.CreditEntryIndexViewModel

<div class="filter-card">
    <form asp-action="Index" method="get">
        <div asp-validation-summary="All"
             class="credit-validation-message"></div>
        <div class="filter-grid">
            <div class="filter-group">
                <label>Search Customer</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Name, village or mobile number..." />
            </div>

            <div class="filter-group">
                <label>From Date</label>
                <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>

            <div class="filter-group">
                <label>To Date</label>
                <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />
            </div>

            <div class="filter-buttons">
                <button type="submit" class="primary-btn">
                    Search
                </button>

                <a asp-action="Index" class="secondary-btn">
                    Reset
                </a>
            </div>
        </div>
    </form>
</div>
