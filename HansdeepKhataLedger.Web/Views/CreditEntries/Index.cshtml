@model HansdeepKhataLedger.Web.Models.CreditEntry.CreditEntryIndexViewModel

@{
    ViewData["Title"] = "Credit Entries";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
}

<div class="customer-page">

    <div class="page-header">
        <div>
            <h2 class="page-title">Credit Entries</h2>
            <p class="page-subtitle">
                View and manage credit transactions across all customers.
            </p>
        </div>

        <a asp-action="Create" class="primary-btn">
            + Add Credit
        </a>
    </div>
    @await Html.PartialAsync("_CreditEntryFilters", Model)
    <div class="filter-card credit-summary">
        <div>
            <p class="page-subtitle">Total Credit Amount</p>
            <h2 class="pending-amount">
                ₹ @Model.TotalCreditAmount.ToString("N2")
            </h2>
            <small>
                Across @Model.TotalRecords credit entries matching your filters
            </small>
        </div>
    </div>

    @await Html.PartialAsync("_CreditEntryTable", Model)

    @await Html.PartialAsync("_CreditEntryPagination", Model)

</div>
